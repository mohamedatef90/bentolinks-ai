{
  "name": "qlip-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "audit:ai": "node scripts/ai-audit-report.mjs",
    "audit:ai:corpus": "node scripts/ai-audit-report.mjs --validate-corpus",
    "test:ai": "node --test tests/ai-contract.test.mjs",
    "test:routing": "node --test tests/link-routing.test.mjs tests/ai-category.test.mjs",
    "test:ownership": "node --test tests/ownership.test.mjs",
    "test:edge": "deno test --no-lock --allow-env --allow-read --allow-net tests/mcp-ownership.deno.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.91.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
